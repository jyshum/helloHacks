# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Maps Platform: browser key (Maps JS, Places) + server key (Directions, Places)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_SERVER_KEY=

# App URL (http://localhost:3000 locally; enables the dev-only "skip verification" button)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Who can sign up (default: student.ubc.ca,ubc.ca,alumni.ubc.ca)
ALLOWED_EMAIL_DOMAINS=
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAINS=

# Comma-separated emails that can review driver licences at /admin
ADMIN_EMAILS=

# Notifications: web push (npx web-push generate-vapid-keys) and email fallback (Gmail app password)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
SMTP_USER=
SMTP_PASS=

# Protects /api/cron/pods-nightly (Vercel Cron sends it as a bearer token)
CRON_SECRET=
